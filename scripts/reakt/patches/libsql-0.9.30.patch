+const HTTP_REQUEST_DEADLINE: Duration = Duration::from_secs(30);
+
+fn validate_content_length(headers: &HeaderMap, limit: usize) -> Result<()> {
+    let Some(length) = headers.get(CONTENT_LENGTH) else {
+        return Ok(());
+    };
+    let length = length
+        .to_str()
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .ok_or_else(|| HranaError::Http("invalid response content length".to_owned()))?;
+    if length > limit as u64 {
+        return Err(HranaError::Http(
+            "response body exceeds limit".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+async fn collect_response_body(mut body: hyper::Body, limit: usize) -> Result<Bytes> {
+    let mut bytes = BytesMut::new();
+    while let Some(chunk) = body.data().await {
+        let chunk = chunk.map_err(HranaError::from)?;
+        let length = bytes
+            .len()
+            .checked_add(chunk.len())
+            .ok_or_else(|| HranaError::Http("response body exceeds limit".to_owned()))?;
+        if length > limit {
+            return Err(HranaError::Http("response body exceeds limit".to_owned()));
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    Ok(bytes.freeze())
+}
+
+async fn read_response(response: hyper::Response<hyper::Body>, limit: usize) -> Result<Bytes> {
+    let status = response.status();
+    if status != StatusCode::OK {
+        return Err(HranaError::Api(format!("status={status}")));
+    }
+    validate_content_length(response.headers(), limit)?;
+    collect_response_body(response.into_body(), limit).await
+}
+
+async fn with_request_deadline<T>(future: impl Future<Output = Result<T>>) -> Result<T> {
+    tokio::time::timeout(HTTP_REQUEST_DEADLINE, future)
+        .await
+        .map_err(|_| HranaError::Http("request deadline exceeded".to_owned()))?
+}
 
