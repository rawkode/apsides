+    #[tokio::test]
+    async fn response_limit_accepts_exact_body_and_rejects_first_extra_byte(
+    ) -> std::result::Result<(), Box<dyn std::error::Error + Send + Sync>> {
+        let exact = response(StatusCode::OK, Some("4"), hyper::Body::from("1234"));
+        assert_eq!(read_response(exact?, 4).await?, "1234");
+
+        let oversized = response(StatusCode::OK, Some("5"), hyper::Body::from("12345"));
+        assert!(matches!(
+            read_response(oversized?, 4).await,
+            Err(HranaError::Http(message)) if message == "response body exceeds limit"
+        ));
+        Ok(())
+    }
+
