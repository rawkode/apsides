+    #[tokio::test(start_paused = true)]
+    async fn one_deadline_bounds_request_and_complete_body(
+    ) -> std::result::Result<(), Box<dyn std::error::Error + Send + Sync>> {
+        let (_sender, pending_body) = hyper::Body::channel();
+        let success = response(StatusCode::OK, None, pending_body)?;
+        let operation = tokio::spawn(with_request_deadline(read_response(success, 4)));
+        tokio::task::yield_now().await;
+        tokio::time::advance(HTTP_REQUEST_DEADLINE).await;
+        assert!(matches!(
+            operation.await?,
+            Err(HranaError::Http(message)) if message == "request deadline exceeded"
+        ));
+        Ok(())
+    }
+}
