{
  "$defs": {
    "AutomationDeclaration": {
      "additionalProperties": false,
      "properties": {
        "actionModuleDigest": {
          "type": "string"
        },
        "actionModuleIdentity": {
          "type": "string"
        },
        "bundleDigest": {
          "description": "The digest-addressed installed bundle that owns this declaration.",
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "rendererAbiVersion": {
          "type": "string"
        },
        "sourceDependency": {
          "$ref": "#/$defs/Dependency",
          "description": "The exact observed object that caused this automation. Collections and\nunobserved objects are not valid automation sources."
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "identity",
        "version",
        "sourceDependency",
        "bundleDigest",
        "actionModuleIdentity",
        "actionModuleDigest",
        "rendererAbiVersion"
      ],
      "type": "object"
    },
    "Dependency": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "apiVersion": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "observationToken": {
              "type": "string"
            },
            "resourceVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "object",
              "type": "string"
            },
            "uid": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "apiVersion",
            "kind",
            "namespace",
            "name",
            "observationToken"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "apiVersion": {
              "type": "string"
            },
            "collectionRevision": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "observationToken": {
              "type": "string"
            },
            "selector": {
              "type": "string"
            },
            "type": {
              "const": "collection",
              "type": "string"
            }
          },
          "required": [
            "type",
            "apiVersion",
            "kind",
            "namespace",
            "selector",
            "collectionRevision",
            "observationToken"
          ],
          "type": "object"
        }
      ]
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "ReadinessDeclaration": {
      "additionalProperties": false,
      "properties": {
        "parameters": true,
        "policy": {
          "type": "string"
        }
      },
      "required": [
        "policy"
      ],
      "type": "object"
    },
    "RenderDisposition": {
      "enum": [
        "apply",
        "hold",
        "explicitEmpty"
      ],
      "type": "string"
    },
    "ResourceDeclaration": {
      "additionalProperties": false,
      "properties": {
        "logicalId": {
          "type": "string"
        },
        "object": true,
        "readiness": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadinessDeclaration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "logicalId",
        "object"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abiVersion": {
      "type": "string"
    },
    "automations": {
      "items": {
        "$ref": "#/$defs/AutomationDeclaration"
      },
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/Dependency"
      },
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    },
    "disposition": {
      "$ref": "#/$defs/RenderDisposition"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceDeclaration"
      },
      "type": "array"
    }
  },
  "required": [
    "abiVersion",
    "disposition",
    "resources",
    "dependencies",
    "automations",
    "diagnostics"
  ],
  "title": "RenderOutputV0",
  "type": "object"
}
