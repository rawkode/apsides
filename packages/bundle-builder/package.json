{
  "name": "@oxideloop/bundle-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@oxideloop/example-bundle": "workspace:*",
    "@oxideloop/sdk": "workspace:*",
    "oxc-transform": "0.58.0",
    "rolldown": "1.0.0-beta.35",
    "ses": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "tsx": "4.19.2",
    "typescript": "5.8.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "tsx src/cli.ts",
    "bundle:e2e": "tsx src/e2e-cli.ts",
    "test:reakt": "tsx src/reakt.test.ts && tsx src/reakt-tsx.test.ts && tsx src/reakt-cli.test.ts",
    "test": "tsx src/index.test.ts && tsx src/e2e-cli.test.ts && tsx src/reakt.test.ts && tsx src/reakt-tsx.test.ts && tsx src/reakt-cli.test.ts"
  }
}
