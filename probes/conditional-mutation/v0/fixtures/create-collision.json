{
  "name": "POST collision refetches and never adopts",
  "input": {
    "probeVersion": "mutation-probe.oxideloop.dev/v0",
    "qualification": {
      "class": "builtInTested",
      "kubernetesMinor": "1.35",
      "gvr": "v1/configmaps"
    },
    "intent": {
      "operation": "createConflict",
      "requestedName": "example",
      "refetched": {
        "state": "existing",
        "identity": { "uid": "someone-elses-uid", "resourceVersion": "9" }
      }
    }
  },
  "expected": {
    "decision": "refetchNoAdopt",
    "reason": "POST collided with an existing identity; refetch is recorded and adoption is forbidden"
  }
